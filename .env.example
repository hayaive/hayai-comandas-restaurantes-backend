# ── Base de datos ──────────────────────────────────────────────────────────
# Rol DUEÑO de las tablas. Sólo para migraciones y para el CLI de Prisma.
DATABASE_URL="postgresql://postgres:cambiar@localhost:5432/hayai_comandas?schema=public"

# Shadow DB: la usa `prisma migrate dev` para calcular el diff. No se usa en
# producción (`migrate deploy` no la necesita).
SHADOW_DATABASE_URL="postgresql://postgres:cambiar@localhost:5432/hayai_comandas_shadow?schema=public"

# Conexión de la APLICACIÓN. Debe ser un rol SIN BYPASSRLS y que NO sea dueño
# de las tablas; es lo que hace efectivo el aislamiento por restaurante el día
# que se active prisma/sql/03_rls.sql.
APP_DATABASE_URL="postgresql://hayai_app:cambiar@localhost:5432/hayai_comandas?schema=public"

# ── Restaurante / operación ────────────────────────────────────────────────
# Zona horaria por defecto al crear un restaurante nuevo.
TZ="America/Caracas"

# ── Sesión ─────────────────────────────────────────────────────────────────
JWT_SECRET="cambiar-en-cada-entorno"
JWT_EXPIRA="12h"

# URL pública base para armar el QR de las reservaciones: <BASE>/r/<slug>/reserva/<codigo>
URL_PUBLICA="http://localhost:5173"

# ── Servidor ───────────────────────────────────────────────────────────────
PORT=3000
