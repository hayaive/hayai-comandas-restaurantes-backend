# ── Base de datos ──────────────────────────────────────────────────────────
# Rol DUEÑO de las tablas. Sólo para migraciones y para el CLI de Prisma.
DATABASE_URL="postgresql://postgres:cambiar@localhost:5432/hayai_comandas?schema=public"

# Shadow DB: la usa `prisma migrate dev` para calcular el diff. No se usa en
# producción (`migrate deploy` no la necesita).
SHADOW_DATABASE_URL="postgresql://postgres:cambiar@localhost:5432/hayai_comandas_shadow?schema=public"

# Conexión de la APLICACIÓN. Debe ser un rol SIN BYPASSRLS y que NO sea dueño
# de las tablas; es lo que hace efectivo el aislamiento por restaurante el día
# que se active prisma/sql/03_rls.sql.
APP_DATABASE_URL="postgresql://hayai_app:cambiar@localhost:5432/hayai_comandas?schema=public"

# ── Restaurante / operación ────────────────────────────────────────────────
# Zona horaria por defecto al crear un restaurante nuevo.
TZ="America/Caracas"

# ── Sesión ─────────────────────────────────────────────────────────────────
JWT_SECRET="cambiar-en-cada-entorno"
JWT_EXPIRA="12h"

# URL pública base para armar el QR de las reservaciones: <BASE>/r/<slug>/reserva/<codigo>
URL_PUBLICA="http://localhost:5173"

# ── Servidor ───────────────────────────────────────────────────────────────
PORT=3000

# URL pública de ESTE backend (no confundir con URL_PUBLICA, que es la del
# FRONTEND). Hace falta para armar URLs ABSOLUTAS de /uploads cuando el
# consumidor no puede resolver una relativa por su cuenta — hoy sólo el
# service worker de push, que no tiene sesión ni sabe a qué API llamar. Sin
# configurar, cae a http://localhost:<PORT> para desarrollo.
URL_BACKEND="http://localhost:3000"

# ── Web Push (notificaciones) ─────────────────────────────────────────────
# Par de claves VAPID del servidor. Genera uno con:
#   npx web-push generate-vapid-keys
# y pega aquí `Public Key` / `Private Key` tal cual las imprime (base64url).
# ⚠️ VAPID_PRIVATE_KEY es un SECRETO: no la subas a git, no la pegues en un
# chat, no la generes "para probar" y la dejes en un archivo versionado. Si
# faltan estas tres variables el servidor arranca igual (Web Push queda
# deshabilitado y sólo se loggea una advertencia): no son un requisito para
# tomar comandas.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# mailto: o https: real — el servicio de push lo usa para contactar al
# operador si algo va mal con los envíos de este servidor.
VAPID_SUBJECT="mailto:soporte@cambiar.com"
